{
  "name": "aligner-tray-tracker",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@expo/ui": "~57.0.12",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.14",
    "expo-linking": "~57.0.7",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "supabase": "2.115.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node ./scripts/start-development.mjs",
    "android": "npm run start -- --android",
    "ios": "npm run start -- --ios",
    "web": "npm run start -- --web",
    "check:ios-ui-purity": "node ./scripts/check-ios-ui-purity.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "validate": "npm run typecheck && npm run lint && npm run check:ios-ui-purity && npm run test"
  },
  "jest": {
    "preset": "jest-expo",
    "cacheDirectory": "<rootDir>/.jest-cache",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "private": true
}
